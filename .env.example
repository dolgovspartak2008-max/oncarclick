# Обязательный секрет ежедневной синхронизации каталога. Без него /api/internal/sync всегда отвечает 401.
# Vercel Cron сам передаёт его в заголовке Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Адрес сайта для вебхука Telegram (например https://oncarclik.vercel.app).
# Если не задан — берётся VERCEL_PROJECT_PRODUCTION_URL, который Vercel выставляет сам.
SITE_URL=

# Telegram-бот и база (значения хранятся только в настройках проекта Vercel, в репозиторий не попадают)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Ключ для разовой настройки вебхука (POST /api/telegram/setup, заголовок x-setup-key). Без него setup отвечает 401.
TELEGRAM_SETUP_SECRET=
BOT_DB_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
